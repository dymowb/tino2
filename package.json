{
  "name": "tino-2-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end test suite for Tino 2 domestic service platform",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test",
    "test:ci:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:functional": "playwright test --grep \"experience|domain\"",
    "test:non-functional": "playwright test --grep \"platform, security, and performance\"",
    "test:performance": "playwright test --grep \"response time\"",
    "test:security": "playwright test --grep \"security|protected|malformed\"",
    "test:accessibility": "playwright test --grep \"keyboard-reachable\"",
    "test:user-management": "playwright test --grep \"customer experience\"",
    "test:provider-management": "playwright test --grep \"provider experience\"",
    "test:service-discovery": "playwright test --grep \"discovery\"",
    "test:quote-management": "playwright test --grep \"domain contracts\"",
    "test:booking-management": "playwright test --grep \"lifecycle|domain contracts\"",
    "test:messaging": "playwright test --grep \"messaging\"",
    "test:payments": "playwright test --grep \"payment\"",
    "test:reviews": "playwright test --grep \"reviews\"",
    "report": "playwright show-report",
    "install-browsers": "playwright install",
    "test-setup": "playwright test --grep \"health, headers\" --project=chromium"
  },
  "dependencies": {
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "playwright",
    "e2e-testing",
    "test-automation",
    "domestic-service",
    "tino-2"
  ],
  "author": "Tino 2 Development Team",
  "license": "MIT"
}
