{
  "name": "tino-2-backend",
  "version": "2.0.0",
  "description": "Tino 2 - Domestic Service Platform Backend API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:debug": "ts-node-dev --inspect --respawn --transpile-only src/server.ts",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --runInBand",
    "test:db:up": "docker compose -f ../docker-compose.yml up -d --wait postgres-test",
    "test:db:down": "docker compose -f ../docker-compose.yml stop postgres-test",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node src/scripts/seedDatabase.ts",
    "migrate": "npm run migration:run",
    "db:reset": "ts-node src/scripts/resetDatabase.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d src/config/typeorm.data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d src/config/typeorm.data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/config/typeorm.data-source.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d src/config/typeorm.data-source.ts migration:show",
    "memory:migration:run": "typeorm-ts-node-commonjs -d src/config/memory.data-source.ts migration:run",
    "memory:migration:revert": "typeorm-ts-node-commonjs -d src/config/memory.data-source.ts migration:revert",
    "memory:migration:show": "typeorm-ts-node-commonjs -d src/config/memory.data-source.ts migration:show"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@sendgrid/mail": "^8.1.5",
    "@sentry/node": "^10.68.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/stripe": "^8.0.417",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.39.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "stripe": "^18.5.0",
    "tsconfig-paths": "^4.2.0",
    "twilio": "^5.9.0",
    "typeorm": "^0.3.31",
    "voyageai": "^0.2.1",
    "winston": "^3.13.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "autocannon": "^2.0.1",
    "clinic": "^0.6.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "loadtest": "^8.2.0",
    "pidusage": "^4.0.1",
    "playwright": "^1.54.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "socket.io-parser": "4.2.7"
  }
}
