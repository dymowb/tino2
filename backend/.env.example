# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ─────────────────────────────────────────────────────────────────────────────
# Main Database  (matches docker-compose.yml postgres-app service)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tino:tino@localhost:5432/tino_app

# Disposable integration-test database. Never point this at development or production.
TEST_DATABASE_URL=postgresql://tino_test:tino_test@localhost:5434/tino_test

# TLS applies to both databases below and follows the connection string's sslmode
# (`sslmode=disable` above means no TLS at all). Whenever TLS *is* used the peer
# certificate is verified: supply the provider CA as inline PEM, as a file path, or
# as `sslrootcert=` on the URL itself.
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=/etc/ssl/certs/postgres-ca.pem
# Development-only escape hatch (same as `sslmode=no-verify` on the URL). Startup
# fails if either is used in production. An unrecognised sslmode, or an `ssl*` URL
# parameter that cannot be honoured, also fails startup rather than dropping TLS.
# DATABASE_SSL_ALLOW_UNAUTHORIZED=false

# ─────────────────────────────────────────────────────────────────────────────
# Memory Database  (pgvector — matches docker-compose.yml postgres-memory)
# ─────────────────────────────────────────────────────────────────────────────
MEMORY_DATABASE_URL=postgresql://tino:tino@localhost:5433/tino_memory

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# Security / Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ─────────────────────────────────────────────────────────────────────────────
# File Upload
# ─────────────────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ─────────────────────────────────────────────────────────────────────────────
# AI provider credentials — configure every provider referenced by an active chain.
# At least one text provider is required for agentic assistant features.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Required application-wide capability profiles. Each is an ordered
# provider:model chain; later targets are fallbacks.
AI_FAST_MODEL_CHAIN=anthropic:your-fast-model
AI_REASONING_MODEL_CHAIN=anthropic:your-reasoning-model
AI_SYNTHESIS_MODEL_CHAIN=anthropic:your-synthesis-model

# Optional workflow override; otherwise rebooking uses AI_FAST_MODEL_CHAIN.
# REBOOK_AI_MODEL_CHAIN=openai:primary-model,anthropic:fallback-model
AI_GATEWAY_RETRIES_PER_MODEL=0
AI_GATEWAY_TIMEOUT_MS=30000

# Required when MEMORY_DATABASE_URL enables semantic memory. Embedding output
# dimensions must match the pgvector schema used by the memory migrations.
AI_EMBEDDING_CHAIN=openai:your-embedding-model,voyage:your-fallback-embedding-model
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_BATCH_SIZE=8
AI_EMBEDDING_RETRIES_PER_MODEL=0
AI_EMBEDDING_TIMEOUT_MS=30000

# Optional OpenAI voice feature models (required only when OPENAI_API_KEY is set
# and the voice endpoints are used).
VOICE_TRANSCRIPTION_MODEL=your-transcription-model
VOICE_TTS_MODEL=your-text-to-speech-model

# ─────────────────────────────────────────────────────────────────────────────
# Voyage AI — optional embedding provider or fallback
# Get key at https://www.voyageai.com/
# ─────────────────────────────────────────────────────────────────────────────
VOYAGE_API_KEY=your-voyage-ai-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Memory System Tuning  (safe defaults — adjust if needed)
# ─────────────────────────────────────────────────────────────────────────────
MEMORY_DEDUP_THRESHOLD=0.92
PROCEDURAL_RULE_AUTO_APPROVE_THRESHOLD=0.85
MEMORY_SEMANTIC_TTL_DAYS=365
MEMORY_EPISODIC_TTL_DAYS=180

# ─────────────────────────────────────────────────────────────────────────────
# Stripe  — REQUIRED for payment features
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps  — optional (GPS features degrade to text-based search without it)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Email  — dev uses Ethereal (fake SMTP, no config needed)
# In prod, set SMTP vars or a real provider
# ─────────────────────────────────────────────────────────────────────────────
FROM_EMAIL=noreply@tino2.com

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ─────────────────────────────────────────────────────────────────────────────
# Third-party services (optional / future use)
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

SENDGRID_API_KEY=your-sendgrid-api-key

AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=tino-2-uploads

FIREBASE_SERVER_KEY=your-firebase-server-key
