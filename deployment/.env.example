# Tino 2 - Production Environment Configuration Template
# Copy this file to .env and update with your production values

# Application Settings
NODE_ENV=production
LOG_LEVEL=info
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# Server Configuration
PORT=3000
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
REACT_APP_API_BASE_URL=https://api.yourdomain.com
REACT_APP_SOCKET_URL=https://api.yourdomain.com
REACT_APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://username:password@postgres:5432/tino2_production
POSTGRES_DB=tino2_production
POSTGRES_USER=tino2_user
POSTGRES_PASSWORD=secure_database_password_here
BACKUP_RETENTION_DAYS=30

# Redis Configuration
REDIS_URL=redis://:redis_password@redis:6379
REDIS_PASSWORD=secure_redis_password_here

# JWT Authentication
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_256_bits
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Twilio SMS Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# SendGrid Email Service
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# SMTP Fallback Email Configuration
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# File Upload Configuration
FILE_UPLOAD_MAX_SIZE=10485760
FILE_UPLOAD_PATH=/app/uploads

# Monitoring and Alerting
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
NOTIFICATION_EMAIL=admin@yourdomain.com
REACT_APP_SENTRY_DSN=https://your_sentry_dsn_here

# SSL Configuration (for nginx)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# Performance Configuration
MAX_CONCURRENT_REQUESTS=1000
DATABASE_CONNECTION_POOL_SIZE=20
REDIS_CONNECTION_POOL_SIZE=10

# Security Headers
HELMET_CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.stripe.com;

# Session Configuration
SESSION_SECRET=your_session_secret_key_here
SESSION_MAX_AGE=86400000

# API Documentation
SWAGGER_ENABLED=false
API_DOCS_AUTH_USER=admin
API_DOCS_AUTH_PASS=secure_docs_password

# Backup Configuration
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-west-2
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key

# External Service URLs
WEBHOOK_BASE_URL=https://api.yourdomain.com/webhook

# Feature Flags
ENABLE_REAL_TIME_MESSAGING=true
ENABLE_GPS_TRACKING=true
ENABLE_PAYMENT_PROCESSING=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true

# Development Override (remove in production)
# NODE_TLS_REJECT_UNAUTHORIZED=0